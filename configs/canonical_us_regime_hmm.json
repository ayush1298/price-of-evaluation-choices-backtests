{
  "experiment_name": "canonical-us-monthly-hmm-mixture",
  "study_scope": "pre_data_gate_candidate",
  "paper_eligible": false,
  "market": "US",
  "rebalance_frequency": "ME",
  "execution_lag_sessions": 1,
  "annualization_factor": 252,
  "transaction_cost_bps": 10.0,
  "minimum_history_sessions": 252,
  "minimum_eligible_assets": 30,
  "long_only": true,
  "max_weight": 0.05,
  "regime": {
    "model": "expanding_gaussian_hmm",
    "n_components": 3,
    "minimum_training_observations": 36,
    "features": [
      "realized_volatility",
      "trailing_market_return",
      "market_drawdown",
      "cross_sectional_dispersion"
    ],
    "ordering_feature": "realized_volatility",
    "state_strategies": {
      "0": {"graph_method": "pcc", "selector": "hub_avoid", "allocator": "inverse_volatility"},
      "1": {"graph_method": "partial_correlation", "selector": "hub_avoid", "allocator": "mean_cvar"},
      "2": {"graph_method": "partial_correlation", "selector": "all", "allocator": "mean_cvar"}
    }
  },
  "seeds": [7, 17, 29, 43, 59]
}
