{
  "experiment_name": "public-us-etf-2010-group-aware-hmm-risk-v1",
  "amendment_id": "ICAIF_CHARTER_AMENDMENT_V2",
  "study_scope": "public_fixed_etf_development_group_aware_diagnostic",
  "paper_eligible": false,
  "data_contract_id": "public-us-etf-2010-v1",
  "market": "US_ETF",
  "rebalance_frequency": "ME",
  "execution_lag_sessions": 1,
  "annualization_factor": 252,
  "transaction_cost_bps": 10.0,
  "minimum_history_sessions": 252,
  "minimum_eligible_assets": 25,
  "long_only": true,
  "max_weight": 0.1,
  "allocation": {
    "min_rebalance_turnover": 0.0
  },
  "regime": {
    "model": "expanding_gaussian_hmm",
    "n_components": 2,
    "minimum_training_observations": 36,
    "n_iter": 200,
    "covariance_type": "diag",
    "startprob_prior": 1.1,
    "transmat_prior": 1.1,
    "ordering_feature": "realized_volatility",
    "features": [
      "realized_volatility",
      "trailing_market_return",
      "market_drawdown",
      "cross_sectional_dispersion"
    ]
  },
  "conditional_risk": {
    "lookback_sessions": 252,
    "minimum_effective_observations": 21,
    "covariance_shrinkage": 0.25,
    "uncertainty_to_unconditional": true,
    "minimum_regime_confidence": 0.1,
    "group_aware_within_group_only": true
  },
  "asset_groups": {
    "path": "configs/universes/us_etf_2010_v1_regime_groups_v1.csv",
    "symbol_column": "symbol",
    "group_column": "regime_group",
    "require_complete": true
  }
}
